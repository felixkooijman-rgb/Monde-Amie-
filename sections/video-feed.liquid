{{ 'section-video-feed.css' | asset_url | stylesheet_tag }}
<script src="{{ 'video-feed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #VideoFeed-{{ section.id }} {
    --video-feed-columns: {{ section.settings.columns_mobile }};
    --video-feed-radius: {{ section.settings.corner_radius }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #VideoFeed-{{ section.id }} {
      --video-feed-columns: {{ section.settings.columns_desktop }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign has_videos = false
  for block in video_blocks
    if block.settings.video != blank
      assign has_videos = true
      break
    endif
  endfor
-%}

{%- if has_videos or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <video-feed
      id="VideoFeed-{{ section.id }}"
      class="video-feed section-{{ section.id }}-padding{% unless section.settings.full_width %} page-width{% endunless %}"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="video-feed__heading {{ section.settings.heading_size }}">
          {%- if section.settings.heading_link != blank -%}
            <a href="{{ section.settings.heading_link }}" class="video-feed__heading-link">
              {{- section.settings.heading | escape -}}
            </a>
          {%- else -%}
            {{- section.settings.heading | escape -}}
          {%- endif -%}
        </h2>
      {%- endif -%}

      <div class="video-feed__wrapper">
        <ul class="video-feed__track" role="list">
          {%- for block in video_blocks -%}
            {%- if block.settings.video != blank -%}
              <li class="video-feed__item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="video-feed__card">
                {%- else -%}
                  <div class="video-feed__card">
                {%- endif -%}
                {{
                  block.settings.video
                  | video_tag:
                    image_size: '600x',
                    loop: true,
                    muted: true,
                    playsinline: true,
                    preload: 'none',
                    class: 'video-feed__video'
                }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- elsif request.design_mode -%}
              <li class="video-feed__item" {{ block.shopify_attributes }}>
                <div class="video-feed__card video-feed__card--placeholder">
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              </li>
            {%- endif -%}
          {%- else -%}
            {%- if request.design_mode -%}
              {%- for i in (1..5) -%}
                <li class="video-feed__item">
                  <div class="video-feed__card video-feed__card--placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>

        <button type="button" class="video-feed__arrow video-feed__arrow--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" hidden>
          {% render 'icon-caret' %}
        </button>
        <button type="button" class="video-feed__arrow video-feed__arrow--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" hidden>
          {% render 'icon-caret' %}
        </button>
      </div>
    </video-feed>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Video feed",
  "tag": "section",
  "class": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@mondeamie"
    },
    {
      "type": "url",
      "id": "heading_link",
      "label": "Heading link",
      "info": "For example your Instagram or TikTok page"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Videos visible on desktop",
      "min": 2,
      "max": 6,
      "step": 0.5,
      "default": 4.5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Videos visible on mobile",
      "min": 1,
      "max": 3,
      "step": 0.1,
      "default": 1.7
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Upload a vertical video (9:16). It plays muted and on repeat."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional: a product or collection the video links to"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video feed",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
